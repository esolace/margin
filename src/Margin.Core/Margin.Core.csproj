<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(RhinoMajor)' != '8' and '$(RhinoMajor)' != '7'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RhinoMajor)' == '8'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(RhinoMajor)' == '7'">net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../design/group-appearance-policy.json" LogicalName="Margin.GroupAppearancePolicy.json"/>
  </ItemGroup>
  <ItemGroup Condition="'$(RhinoMajor)' == '7'">
    <PackageReference Include="System.Text.Json" Version="8.0.6"/>
    <PackageReference Include="PolySharp" Version="1.17.1" PrivateAssets="all"/>
  </ItemGroup>
  <PropertyGroup Condition="'$(MarginLegacyCheck)' == 'true'">
    <DefineConstants>$(DefineConstants);MARGIN_LEGACY_CHECK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(RhinoMajor)' == '7' or '$(MarginLegacyCheck)' == 'true'">
    <EmbeddedResource Include="LegacyUnicode.json" LogicalName="Margin.LegacyUnicode.json"/>
  </ItemGroup>
</Project>
